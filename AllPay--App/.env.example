# Copy to .env and adjust as needed:
#   copy .env.example .env

# Local development (recommended) — dashboard backend on port 5000
# Must match the same MongoDB the Admin Employees page uses, or invite codes will fail.
API_BASE_URL=http://localhost:5000/api
USE_LOCAL_API=true

# Production (Render) — only when that deploy uses the same DB as your admin invites
# API_BASE_URL=https://allpay-dashboard.onrender.com/api
# USE_LOCAL_API=false

# Optional sync secret (match AllPay-Dashboard/backend/.env MOBILE_SYNC_SECRET)
MOBILE_SYNC_SECRET=
