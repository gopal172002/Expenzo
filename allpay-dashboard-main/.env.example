# =============================================================================
# AllPay Dashboard — environment template (frontend + Docker Compose)
# =============================================================================
# Copy this file to `.env` in the same directory:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
#
# Vite loads variables prefixed with VITE_ at build/dev time.
# Docker Compose also reads `.env` here for Razorpay variables passed to the API container.
# =============================================================================

# Production (Render) — free-tier cold start can make first request slow:
VITE_API_BASE_URL=https://expenzo-gchd.onrender.com/api
# Local dev (Vite proxies /api → backend on port 5000):
# VITE_API_BASE_URL=/api
# Direct to local backend:
# VITE_API_BASE_URL=http://localhost:5000/api

# Google Maps (admin payment location marker on transaction detail)
# Create a browser-restricted key with Maps JavaScript API enabled:
VITE_GOOGLE_MAPS_API_KEY=

# --- Razorpay collect; paste RazorpayX account number when the business is approved
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
USE_RAZORPAY_UPI=true
